<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Portfolio Manager — Sujesh</title><link rel="stylesheet" href="/admin.css"></head><body><main>
<header class="adminhead"><div><small>DATABASE-BACKED PORTFOLIO MANAGER</small><h1>Welcome, <%= user.username %>.</h1><p>Everything you save here is written directly to the portfolio database. No JSON export. No code editing.</p></div><div><a href="/" class="back">View site ↗</a><form method="post" action="/admin/logout"><button class="logout">Log out</button></form></div></header>
<div class="notice"><b>How this works:</b> Add or edit content below and click <b>Save</b>. The public portfolio reads from the same database, so changes appear immediately.</div>

<section class="panel"><h2>Profile</h2><form method="post" action="/admin/profile"><div class="grid">
<% [["name","Name"],["headline","Headline"],["positioning","Positioning"],["location","Location"],["education","Education"],["cgpa","CGPA"],["graduation","Graduation"],["email","Email"],["github","GitHub"],["linkedin","LinkedIn"],["resume","Resume path"]].forEach(([k,l])=>{ %><label><%= l %><input name="<%= k %>" value="<%= d.profile[k]||"" %>"></label><% }) %></div><label>Bio<textarea name="bio"><%= d.profile.bio %></textarea></label><button>Save profile</button></form></section>

<section class="panel"><h2>Projects</h2><% d.projects.forEach(p=>{ %><form class="item" method="post" action="/admin/projects/save"><input type="hidden" name="id" value="<%= p.id %>"><div class="itemhead"><b><%= p.title %></b><button class="danger" formaction="/admin/projects/delete">Delete</button></div><div class="grid"><label>Title<input name="title" value="<%= p.title %>"></label><label>Category<input name="category" value="<%= p.category %>"></label><label>Year<input name="year" value="<%= p.year %>"></label><label>Result<input name="result" value="<%= p.result %>"></label><label>GitHub<input name="github" value="<%= p.github %>"></label><label>Live demo<input name="demo" value="<%= p.demo %>"></label></div><label>Description<textarea name="description"><%= p.description %></textarea></label><label>Tags — comma separated<input name="tags" value="<%= p.tags.join(", ") %>"></label><label class="check"><input type="checkbox" name="featured" <%= p.featured?"checked":"" %>> Featured project</label><button>Save project</button></form><% }) %>
<form class="item new" method="post" action="/admin/projects/save"><h3>+ Add new project</h3><div class="grid"><label>Title<input name="title" required></label><label>Category<input name="category" value="AI"></label><label>Year<input name="year" value="2026"></label><label>Result<input name="result"></label><label>GitHub<input name="github"></label><label>Live demo<input name="demo"></label></div><label>Description<textarea name="description"></textarea></label><label>Tags — comma separated<input name="tags"></label><label class="check"><input type="checkbox" name="featured"> Featured project</label><button>Add project</button></form></section>

<section class="panel"><h2>Skills</h2><% d.skills.forEach(s=>{ %><form class="compact" method="post" action="/admin/skills/save"><input type="hidden" name="id" value="<%= s.id %>"><input name="name" value="<%= s.name %>"><input name="group_name" value="<%= s.group_name %>"><input name="level" value="<%= s.level %>"><button>Save</button><button class="danger" formaction="/admin/skills/delete">Delete</button></form><% }) %><form class="compact new" method="post" action="/admin/skills/save"><input name="name" placeholder="New skill" required><input name="group_name" value="AI"><input name="level" value="Learning"><button>Add skill</button></form></section>

<section class="panel"><h2>Experience</h2><% d.experience.forEach(x=>{ %><form class="item" method="post" action="/admin/experience/save"><input type="hidden" name="id" value="<%= x.id %>"><div class="itemhead"><b><%= x.role %></b><button class="danger" formaction="/admin/experience/delete">Delete</button></div><div class="grid"><label>Period<input name="period" value="<%= x.period %>"></label><label>Role<input name="role" value="<%= x.role %>"></label><label>Organization<input name="organization" value="<%= x.organization %>"></label></div><label>Description<textarea name="description"><%= x.description %></textarea></label><button>Save experience</button></form><% }) %><form class="item new" method="post" action="/admin/experience/save"><h3>+ Add experience</h3><div class="grid"><label>Period<input name="period" value="2026"></label><label>Role<input name="role" required></label><label>Organization<input name="organization"></label></div><label>Description<textarea name="description"></textarea></label><button>Add experience</button></form></section>

<section class="panel"><h2>Certifications</h2><% d.certifications.forEach(x=>{ %><form class="compact" method="post" action="/admin/certifications/save"><input type="hidden" name="id" value="<%= x.id %>"><input name="text" value="<%= x.text %>"><button>Save</button><button class="danger" formaction="/admin/certifications/delete">Delete</button></form><% }) %><form class="compact new" method="post" action="/admin/certifications/save"><input name="text" placeholder="New certification" required><button>Add</button></form></section>

<section class="panel"><h2>Achievements</h2><% d.achievements.forEach(x=>{ %><form class="compact" method="post" action="/admin/achievements/save"><input type="hidden" name="id" value="<%= x.id %>"><input name="text" value="<%= x.text %>"><button>Save</button><button class="danger" formaction="/admin/achievements/delete">Delete</button></form><% }) %><form class="compact new" method="post" action="/admin/achievements/save"><input name="text" placeholder="New achievement" required><button>Add</button></form></section>
</main></body></html>